# Passed as the last --env-file to the demo's compose by `make demo-up`.
# Keep DEMO_VERSION equal to infra/otel-demo/VERSION (the checked-out demo tag).
DEMO_VERSION=3.0.0
# Where the collector posts OTLP/JSON. The API runs on the host: `make api`.
AEGISOPS_INGEST_ENDPOINT=http://host.docker.internal:8000/ingest
