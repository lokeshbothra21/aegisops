# Copy to .env for local overrides. Never commit .env (see .gitignore).
AEGIS_ENV=local
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=false
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5433/aegis
AEGIS_INGEST_MAX_BODY_BYTES=16777216
AEGIS_ADMIN_TOKEN=change-me-local-only
AEGIS_JOBS_ENABLED=true
AEGIS_RETENTION_HOURS=24
AEGIS_FLAGD_CONFIG_PATH=../opentelemetry-demo/src/flagd/demo.flagd.json
AEGIS_ALERTS_ENABLED=true
AEGIS_ALERT_INTERVAL_S=15
# OrbStack: /Users/<you>/.orbstack/run/docker.sock  Docker Desktop: /var/run/docker.sock
AEGIS_DOCKER_SOCKET=
AEGIS_DOCKER_COMPOSE_PROJECT=opentelemetry-demo
# Model providers (config/models.yaml). Free tiers: aistudio.google.com, console.groq.com
AEGIS_GEMINI_API_KEY=
AEGIS_GROQ_API_KEY=
